<view class="page">
  <view class="notify" wx:if="{{notifyText}}">{{notifyText}}</view>
  <!-- 拼图战绩卡：青柠渐变 + 字母拼块装饰 -->
  <view class="mastery-card">
    <view class="deco-tile tile-a">A</view>
    <view class="deco-tile tile-b">B</view>
    <view class="deco-dot dot-a"></view>
    <view class="deco-dot dot-b"></view>
    <view class="mastery-icon">🧩</view>
    <view class="mastery-text">
      <text class="mastery-title">单词拼图战绩</text>
      <text class="mastery-desc">本轮已拼对 {{correct}} / {{total}} 词 · 拼对才过关</text>
    </view>
    <view class="mastery-badge">{{correct}}</view>
  </view>

  <view class="topbar">
    <view class="stat-box"><text class="stat-label">进度</text><text class="stat-val">{{qIndex + 1}}/{{total}}</text></view>
    <view class="stat-box"><text class="stat-label">得分</text><text class="stat-val">{{score}}</text></view>
    <view class="stat-box"><text class="stat-label">拼对</text><text class="stat-val">{{correct}}</text></view>
  </view>

  <!-- 册次/单元选择器：状态栏下方，选完按新范围重出题 -->
  <view class="vol-dropdown">
    <view class="vol-mask" wx:if="{{volOpen}}" bindtap="closeVolMenu"></view>
    <view class="vol-trigger" bindtap="toggleVolMenu">
      <view class="vol-trigger-left">
        <view class="vol-trigger-icon">🎯</view>
        <view class="vol-trigger-text">
          <text class="vol-trigger-cap">点击换册次 / 单元范围</text>
          <text class="vol-trigger-name">{{volumes[activeVol-1].name}} · {{activeUnit === 0 ? '整册混合' : 'Unit ' + activeUnit}}</text>
        </view>
      </view>
      <view class="vol-trigger-right"><view class="vol-caret {{volOpen ? 'vol-caret-open' : ''}}"></view></view>
    </view>
    <view class="vol-panel" wx:if="{{volOpen}}">
      <view class="vol-group" wx:for="{{volGroups}}" wx:key="title" wx:for-item="g">
        <view class="vol-group-head"><text class="vol-group-title">{{g.title}}</text><text class="vol-group-hint">{{g.hint}}</text></view>
        <view class="vol-group-items">
          <view class="vol-opt {{activeVol === sub.v ? 'vol-opt-on' : ''}} {{sub.special ? 'vol-opt-sp' : ''}}" wx:for="{{g.items}}" wx:key="v" wx:for-item="sub" data-v="{{sub.v}}" bindtap="switchVol">
            <text class="vol-opt-name">{{sub.name}}</text><text class="vol-opt-check" wx:if="{{activeVol === sub.v}}">✓</text>
          </view>
        </view>
      </view>
      <view class="vol-group">
        <view class="vol-group-head"><text class="vol-group-title">② 出题范围</text><text class="vol-group-hint">选单元只出该单元，整册混合全册随机</text></view>
        <view class="vol-group-items">
          <view class="vol-opt {{activeUnit === item.u ? 'vol-opt-on' : ''}}" wx:for="{{unitOptions}}" wx:key="u" data-u="{{item.u}}" bindtap="switchUnit">
            <text class="vol-opt-name">{{item.name}}</text><text class="vol-opt-check" wx:if="{{activeUnit === item.u}}">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="question-card">
    <view class="q-head">
      <text class="q-label">根据意思拼出单词</text>
      <text class="speak-btn" bindtap="speakQuestion">🔊</text>
    </view>
    <text class="q-main">{{currentQ.q}}</text>
    <text class="q-phonetic" wx:if="{{currentQ.phonetic}}">/{{currentQ.phonetic}}/</text>
  </view>


  <!-- 答案区 -->
  <view class="answer-box {{feedback}}">
    <view class="answer-slot" wx:for="{{answer}}" wx:key="id" data-id="{{item.id}}" bindtap="tapAnswer">
      <text class="answer-ch">{{item.ch}}</text>
    </view>
    <view class="answer-placeholder" wx:if="{{answer.length === 0}}">点下方字母拼出单词</view>
    <text class="answer-mark" wx:if="{{feedback === 'right'}}">✓</text>
    <text class="answer-mark answer-mark-wrong" wx:elif="{{feedback === 'wrong'}}">✕</text>
  </view>

  <!-- 字母池 -->
  <view class="letter-pool">
    <view class="letter-btn {{item.used ? 'letter-used' : ''}}" wx:for="{{letters}}" wx:key="id" data-id="{{item.id}}" bindtap="tapLetter">
      <text class="letter-ch">{{item.ch}}</text>
    </view>
  </view>

  <view class="action-row">
    <button class="hint-btn" bindtap="hint">💡 提示</button>
  </view>

  <view class="overlay" wx:if="{{gameOver}}">
    <view class="result-card">
      <text class="result-emoji">✏️</text>
      <text class="result-title">拼图完成！</text>
      <view class="result-stats">
        <view><text class="rs-num">{{correct}}</text><text class="rs-label">拼对</text></view>
        <view><text class="rs-num">{{score}}</text><text class="rs-label">得分</text></view>
      </view>
      <button class="btn-primary result-btn" bindtap="backHome">返回地图</button>
    </view>
  </view>

  <!-- 底部装饰：散落的拼图块 + 字母块（单词拼图专属） -->
  <view class="foot-deco sp-deco">
    <view class="sp-tile sp-t1">A</view>
    <view class="sp-tile sp-t2">E</view>
    <view class="sp-tile sp-t3">?</view>
    <view class="sp-dot sp-d1"></view>
    <view class="sp-dot sp-d2"></view>
  </view>
</view>
