.page { position: relative; box-sizing: border-box; min-height: 100vh; padding: 24rpx 28rpx 60rpx; }
.mastery-card { position: relative; overflow: hidden; box-sizing: border-box; display: flex; align-items: center; min-height: 180rpx; background: linear-gradient(135deg, #B8E04C, #7FBF2F); border-radius: 28rpx; padding: 36rpx 30rpx; color: #FFF; box-shadow: 0 6rpx 0 #DCECA8, 0 10rpx 24rpx rgba(127,191,47,.18); }
.mastery-icon { position: relative; z-index: 2; width: 88rpx; height: 88rpx; border-radius: 24rpx; background: rgba(255,255,255,.22); border: 2rpx solid rgba(255,255,255,.38); display: flex; align-items: center; justify-content: center; font-size: 42rpx; flex-shrink: 0; }
.mastery-text { position: relative; z-index: 2; margin-left: 20rpx; display: flex; flex-direction: column; flex: 1; }
.mastery-title { font-size: 36rpx; font-weight: 800; }
.mastery-desc { margin-top: 8rpx; font-size: 22rpx; opacity: .95; }
.mastery-badge { position: relative; z-index: 2; background: rgba(255,255,255,.25); border-radius: 999rpx; padding: 10rpx 24rpx; font-size: 34rpx; font-weight: 800; }
.deco-tile { position: absolute; z-index: 1; width: 58rpx; height: 58rpx; border-radius: 16rpx; background: rgba(255,255,255,.16); border: 2rpx solid rgba(255,255,255,.28); display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 800; color: rgba(255,255,255,.7); }
.tile-a { right: 126rpx; top: -10rpx; transform: rotate(-14deg); }
.tile-b { right: 36rpx; bottom: -16rpx; transform: rotate(16deg); }
.deco-dot { position: absolute; z-index: 1; width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255,255,255,.4); }
.dot-a { right: 196rpx; bottom: 30rpx; }
.dot-b { right: 88rpx; top: 16rpx; width: 8rpx; height: 8rpx; }
.topbar { display: flex; margin-top: 20rpx; }
.stat-box {
  flex: 1; margin-right: 14rpx; background: #F1F8DF; border-radius: 20rpx;
  padding: 20rpx 8rpx; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 6rpx 0 #DCECA8;
}
.stat-box:last-child { margin-right: 0; }
.stat-label { font-size: 20rpx; color: #5B8F1F; }
.stat-val { margin-top: 6rpx; font-size: 32rpx; font-weight: 800; color: #5B8F1F; }
.question-card {
  margin-top: 24rpx; background: #FFFFFF; border: 3rpx solid #D6F0EA;
  border-radius: 28rpx; padding: 36rpx 28rpx; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 6rpx 0 #DCECA8, 0 10rpx 24rpx rgba(127,191,47,.08);
}
.q-label { font-size: 24rpx; color: #9A96B8; }
.q-main { margin-top: 14rpx; font-size: 40rpx; font-weight: 800; color: #2B2456; text-align: center; line-height: 1.4; }
.q-phonetic { margin-top: 10rpx; font-size: 24rpx; color: #38B6A0; }
.answer-box {
  position: relative;
  margin-top: 32rpx; min-height: 120rpx; background: #FFFFFF;
  border: 4rpx dashed #B8E6DC; border-radius: 24rpx;
  display: flex; flex-wrap: wrap; align-items: center; justify-content: center; padding: 16rpx;
}
.answer-box.right { border-color: #38B6A0; background: #E8FAF5; }
.answer-box.wrong { border-color: #FF5C7A; background: #FFF0F3; }
.answer-slot {
  width: 72rpx; height: 88rpx; margin: 6rpx; border-radius: 14rpx;
  background: #D6F0EA; display: flex; align-items: center; justify-content: center;
}
.answer-ch { font-size: 40rpx; font-weight: 800; color: #1E8E78; }
.answer-placeholder { font-size: 26rpx; color: #B8B4CE; }
.letter-pool { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 32rpx; }
.letter-btn {
  width: 96rpx; height: 96rpx; margin: 8rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, #7B6BF0, #5B4BD6);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(91,75,214,0.25);
}
.letter-btn:active { transform: scale(0.92); }
.letter-used { background: #E3E0F0; box-shadow: none; }
.letter-used .letter-ch { color: #B8B4CE; }
.letter-ch { font-size: 42rpx; font-weight: 800; color: #FFFFFF; }
.action-row { display: flex; justify-content: center; margin-top: 32rpx; }
.hint-btn { background: #FFF4E0; color: #D98600; font-size: 26rpx; padding: 16rpx 48rpx; font-weight: 600; }
.overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(43,36,86,0.55); display: flex; align-items: center; justify-content: center;
}
.result-card {
  width: 600rpx; background: #FFFFFF; border-radius: 36rpx; padding: 48rpx 40rpx;
  display: flex; flex-direction: column; align-items: center;
}
.result-emoji { font-size: 80rpx; }
.result-title { margin-top: 12rpx; font-size: 38rpx; font-weight: 800; }
.result-stats { display: flex; width: 100%; margin-top: 32rpx; justify-content: space-around; }
.result-stats view { display: flex; flex-direction: column; align-items: center; }
.rs-num { font-size: 42rpx; font-weight: 800; color: #38B6A0; }
.rs-label { margin-top: 6rpx; font-size: 22rpx; color: #9A96B8; }
.result-btn { width: 100%; margin-top: 36rpx; font-size: 30rpx; padding: 22rpx 0; }
/* 底部装饰：散落拼图块 + 字母块（青柠系，不拦截点击） */
.foot-deco { position: absolute; left: 0; right: 0; bottom: 0; height: 120rpx; z-index: 0; pointer-events: none; overflow: hidden; }
.sp-tile { position: absolute; width: 52rpx; height: 52rpx; border-radius: 12rpx; background: rgba(127,191,47,.16); border: 2rpx solid rgba(127,191,47,.3); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 800; color: rgba(90,140,25,.5); }
.sp-t1 { left: 10%; bottom: 22rpx; transform: rotate(-14deg); } .sp-t2 { right: 16%; bottom: 34rpx; transform: rotate(12deg); } .sp-t3 { left: 50%; bottom: 12rpx; transform: rotate(-6deg); }
.sp-dot { position: absolute; width: 10rpx; height: 10rpx; border-radius: 50%; background: rgba(127,191,47,.35); }
.sp-d1 { left: 28%; bottom: 62rpx; } .sp-d2 { right: 30%; bottom: 74rpx; }
/* 拼写答案框右上角判定角标 */
.answer-mark { position: absolute; right: 18rpx; top: -18rpx; width: 46rpx; height: 46rpx; border-radius: 50%; background: #38B6A0; color: #FFF; font-size: 30rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 0 #2B8C7C; }
.answer-mark-wrong { background: #FF4D6D; box-shadow: 0 4rpx 0 #D93A57; }
