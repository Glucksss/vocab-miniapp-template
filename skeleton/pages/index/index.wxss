.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  background: #F4F2FF;
}

/* 顶部状态行 */
.status-bar { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 4rpx 24rpx; }
.logo-group { display: flex; align-items: center; gap: 14rpx; }
.logo-badge { font-size: 34rpx; font-weight: 800; color: #2B2456; letter-spacing: 1rpx; }
.help-btn { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #C4BDE4; color: #7F77DD; font-size: 22rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; line-height: 1; }
.status-pills { display: flex; gap: 10rpx; }
.pill { padding: 10rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; }
.pill-star { background: #FFF3D8; color: #B5840B; }
.pill-fire { background: #FFEAE4; color: #D95B36; }
.pill-energy { background: #EDEBFF; color: #5B4BD6; }

/* 继续闯关大卡 · 星际深蓝渐变（色值取自参考图）+ 宇宙装饰 */
.continue-card {
  position: relative; overflow: hidden;
  border-radius: 32rpx; padding: 34rpx 32rpx 30rpx;
  background: linear-gradient(160deg, #162653 0%, #1B2A59 55%, #1E294A 100%);
  border: 1rpx solid #2B3E72;
  box-shadow: 0 16rpx 44rpx rgba(16, 31, 71, 0.36);
}
.cc-glow { position: absolute; right: -70rpx; top: -90rpx; width: 280rpx; height: 280rpx; border-radius: 50%; background: rgba(120,150,230,0.10); }
.cc-orbit { position: absolute; right: 20rpx; top: 108rpx; width: 170rpx; height: 76rpx; border: 1rpx dashed rgba(180,205,255,0.20); border-radius: 50%; transform: rotate(-16deg); }
/* 星点 ✦✧ */
.cc-star { position: absolute; color: #F5D77A; z-index: 0; }
.cc-star-1 { top: 12rpx; left: 22rpx; font-size: 26rpx; }
.cc-star-2 { top: 56rpx; left: 74rpx; font-size: 17rpx; color: #8FA6DC; }
.cc-star-3 { top: 84rpx; right: 210rpx; font-size: 20rpx; }
.cc-star-4 { top: 182rpx; left: 26rpx; font-size: 19rpx; }
.cc-star-5 { top: 226rpx; left: 88rpx; font-size: 17rpx; color: #8FA6DC; }
.cc-star-6 { bottom: 88rpx; right: 36rpx; font-size: 24rpx; }
.cc-star-7 { bottom: 20rpx; left: 34rpx; font-size: 18rpx; color: #8FA6DC; }
/* 土星：纯 CSS，顶部中间空位，不压文字 */
.cc-saturn { position: absolute; top: 20rpx; left: 210rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: #C9A2E8; z-index: 0; }
.cc-saturn-ring { position: absolute; left: -12rpx; top: 13rpx; width: 64rpx; height: 16rpx; border: 3rpx solid #F5D77A; border-radius: 50%; transform: rotate(-22deg); }
/* 卡通飞船：纯 CSS 拼装，位置在「下一站」行右侧，不压顶部册次名 */
.cc-ship { position: absolute; right: 22rpx; top: 96rpx; width: 116rpx; height: 82rpx; z-index: 0; }
.cc-ship-body { position: absolute; left: 30rpx; top: 26rpx; width: 76rpx; height: 38rpx; background: #FFF3DF; border: 2rpx solid #F5D77A; border-radius: 50%; }
.cc-ship-window { position: absolute; left: 68rpx; top: 32rpx; width: 23rpx; height: 23rpx; background: #3E7FC4; border: 3rpx solid #F5D77A; border-radius: 50%; }
.cc-ship-glint { position: absolute; left: 74rpx; top: 37rpx; width: 7rpx; height: 7rpx; background: #CDEBFF; border-radius: 50%; }
.cc-ship-nose { position: absolute; left: 102rpx; top: 44rpx; width: 8rpx; height: 8rpx; background: #FFE08A; border-radius: 50%; }
.cc-ship-wing { position: absolute; left: 26rpx; width: 40rpx; height: 14rpx; background: #F5811F; border-radius: 8rpx; }
.cc-ship-wing-a { top: 18rpx; transform: rotate(-34deg); }
.cc-ship-wing-b { top: 62rpx; transform: rotate(34deg); }
.cc-ship-flame { position: absolute; left: 2rpx; top: 37rpx; width: 30rpx; height: 18rpx; background: #FFB347; border-radius: 50%; }
.cc-top { display: flex; align-items: baseline; justify-content: space-between; position: relative; z-index: 2; }
.cc-label { font-size: 26rpx; color: #AFC0E8; font-weight: 600; }
.cc-vol { font-size: 30rpx; color: #F5D77A; font-weight: 800; }
.cc-next { margin-top: 22rpx; font-size: 44rpx; font-weight: 800; color: #FFF; position: relative; z-index: 2; max-width: 470rpx; }
.cc-progress { display: flex; align-items: center; gap: 16rpx; margin-top: 26rpx; position: relative; z-index: 2; }
.cc-track { flex: 1; height: 14rpx; border-radius: 999rpx; background: rgba(255,255,255,0.20); overflow: hidden; }
.cc-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg,#FFD98A,#F7B733); }
.cc-count { font-size: 22rpx; color: #DCE5FA; font-weight: 700; }
.cc-btn { margin-top: 28rpx; padding: 20rpx; border-radius: 999rpx; background: linear-gradient(135deg,#FFB347,#F5811F); color: #FFF; text-align: center; font-size: 28rpx; font-weight: 800; position: relative; z-index: 2; }

/* 册次下拉 */
.vol-dropdown { margin-top: 26rpx; position: relative; z-index: 30; }
.vol-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: transparent; z-index: 1; }
.vol-trigger { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 26rpx; border-radius: 22rpx; background: #EEEDFE; border: 1rpx solid #CECBF6; position: relative; z-index: 2; }
.vol-trigger-left { display: flex; align-items: center; gap: 18rpx; }
.vol-trigger-icon { width: 64rpx; height: 64rpx; border-radius: 16rpx; background: #7F77DD; display: flex; align-items: center; justify-content: center; font-size: 34rpx; flex-shrink: 0; }
.vol-trigger-text { display: flex; flex-direction: column; }
.vol-trigger-cap { font-size: 21rpx; color: #7F77DD; }
.vol-trigger-name { font-size: 28rpx; font-weight: 800; color: #534AB7; }
.vol-trigger-right { display: flex; align-items: center; gap: 12rpx; }
.vol-change-tag { padding: 8rpx 18rpx; border-radius: 999rpx; background: #7F77DD; color: #FFF; font-size: 22rpx; font-weight: 700; }
.vol-caret { width: 16rpx; height: 16rpx; border-right: 3rpx solid #7F77DD; border-bottom: 3rpx solid #7F77DD; transform: translateY(-4rpx) rotate(45deg); transition: transform 0.2s; }
.vol-caret-open { transform: translateY(2rpx) rotate(225deg); }
.vol-panel { position: absolute; left: 0; right: 0; top: 96rpx; background: #FFF; border-radius: 22rpx; border: 1rpx solid #E6E2FA; box-shadow: 0 16rpx 44rpx rgba(43,36,86,0.16); padding: 12rpx 20rpx 20rpx; z-index: 20; }
.vol-group { margin-top: 14rpx; }
.vol-group-head { display: flex; align-items: baseline; gap: 12rpx; padding: 6rpx 8rpx 12rpx; border-bottom: 1rpx solid #F0EEFA; }
.vol-group-title { font-size: 24rpx; font-weight: 800; color: #5B4BD6; }
.vol-group-hint { font-size: 19rpx; color: #AAA6C2; }
.vol-group-items { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.vol-opt { display: flex; align-items: center; gap: 8rpx; padding: 14rpx 22rpx; border-radius: 999rpx; background: #F6F5FC; border: 1rpx solid #EDEBF8; font-size: 23rpx; color: #6B6692; }
.vol-opt-on { background: #5B4BD6; border-color: #5B4BD6; color: #FFF; font-weight: 700; }
.vol-opt-sp { background: #FFF6E5; border-color: #F5C96B; color: #B8860B; }
.vol-opt-sp.vol-opt-on { background: #E89A1C; border-color: #E89A1C; color: #FFF; }
.vol-opt-check { font-size: 20rpx; }

/* 今日任务 */
.section-title { margin: 40rpx 6rpx 20rpx; font-size: 30rpx; font-weight: 800; color: #2B2456; }
.section-sub { margin-left: 12rpx; font-size: 21rpx; font-weight: 400; color: #9A96B6; }
.task-grid { display: flex; gap: 16rpx; }
.task-card {
  flex: 1; position: relative; border-radius: 26rpx; padding: 28rpx 12rpx 24rpx;
  background: #FFF; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(91,75,214,0.08);
}
.task-icon { font-size: 50rpx; }
.task-name { margin-top: 12rpx; font-size: 24rpx; font-weight: 700; color: #3B3565; }
.task-badge { margin-top: 8rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: #EEEAFE; color: #5B4BD6; font-size: 20rpx; font-weight: 700; }
.task-desc { margin-top: 8rpx; font-size: 20rpx; color: #9A96B6; }
.task-pill { display: inline-block; margin-top: 8rpx; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; }
.pill-quick { background: #FCE8EE; color: #C24A6B; }
.pill-draw { background: #FFF1D4; color: #9A6A12; }
.pill-review { background: #EEEAFE; color: #5B4BD6; }
.task-review { border-bottom: 6rpx solid #8A7CF0; }
.task-draw { border-bottom: 6rpx solid #F5C96B; }
.task-quick { border-bottom: 6rpx solid #E07B94; }

/* 小入口 */
.mini-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 32rpx; }
.mini-card {
  width: calc(50% - 8rpx); box-sizing: border-box;
  display: flex; align-items: center; padding: 24rpx 26rpx;
  background: #FFF; border-radius: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(91,75,214,0.06);
}
.mini-icon { font-size: 44rpx; margin-right: 18rpx; }
.mini-name { font-size: 24rpx; font-weight: 700; color: #3B3565; }

.bottom-hint { margin-top: 44rpx; text-align: center; font-size: 20rpx; color: #A8A4C2; }

/* 顶部可点胶囊：加一层极淡描边示意可点，不用虚线 */
.pill { border: 1rpx solid rgba(0,0,0,0.04); }

/* 奖励速览条：默认折叠，只露一行低调提示，点开才展规则 */
.reward-strip { margin-top: 20rpx; border-radius: 20rpx; background: #FFFBF2; border: 1rpx solid #F3E2BC; overflow: hidden; }
.rs-head { display: flex; align-items: center; padding: 18rpx 22rpx; }
.rs-emoji { font-size: 32rpx; margin-right: 12rpx; }
.rs-title { font-size: 25rpx; font-weight: 800; color: #9A6A12; flex-shrink: 0; }
.rs-brief { flex: 1; margin-left: 14rpx; font-size: 20rpx; color: #B99A60; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rs-arrow { font-size: 34rpx; color: #C79A3E; margin-left: 8rpx; line-height: 1; transform: rotate(90deg); transition: transform .2s; }
.rs-arrow-open { transform: rotate(-90deg); }
.rs-body { padding: 0 22rpx 24rpx; }
.rs-row { display: flex; align-items: flex-start; margin-top: 16rpx; }
.rs-tag { flex-shrink: 0; width: 36rpx; height: 36rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 19rpx; font-weight: 700; margin-right: 14rpx; }
.rs-tag-get { background: #E4F5EA; color: #2E8B57; }
.rs-tag-miss { background: #FFECEF; color: #C4183C; }
.rs-tag-use { background: #EDEBFF; color: #5B4BD6; }
.rs-tag-badge { background: #FFF0D8; color: #C08A1E; }
.rs-text { flex: 1; font-size: 22rpx; color: #6B5A3A; line-height: 1.6; }
.rs-sep { height: 1rpx; background: #F0E2C2; margin-top: 18rpx; }
.rs-foot { margin-top: 20rpx; font-size: 19rpx; color: #B09463; line-height: 1.6; }
.task-gain { margin-top: 8rpx; font-size: 18rpx; color: #C08A1E; }

/* 首次三步引导浮层：盖在首页上方，不占布局 */
.guide-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(20,16,50,.62); z-index: 200; }
.guide-card { position: fixed; left: 56rpx; right: 56rpx; top: 50%; transform: translateY(-50%); z-index: 201; background: #FFF; border-radius: 32rpx; padding: 40rpx 36rpx 36rpx; box-shadow: 0 24rpx 70rpx rgba(20,16,50,.32); }
.gc-head { text-align: center; }
.gc-title { display: block; font-size: 36rpx; font-weight: 800; color: #2B2456; }
.gc-sub { display: block; margin-top: 8rpx; font-size: 23rpx; color: #9A96B8; }
.gc-steps { margin-top: 30rpx; }
.gc-step { display: flex; align-items: flex-start; padding: 18rpx; border-radius: 20rpx; background: #F7F5FF; margin-bottom: 14rpx; }
.gc-step:last-child { margin-bottom: 0; }
.gc-num { flex-shrink: 0; width: 44rpx; height: 44rpx; border-radius: 50%; background: #5B4BD6; color: #FFF; font-size: 24rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.gc-num-2 { background: #FF9A4D; }
.gc-num-3 { background: #E07B94; }
.gc-step-text { flex: 1; display: flex; flex-direction: column; }
.gc-step-title { font-size: 26rpx; font-weight: 700; color: #3B3565; line-height: 1.4; }
.gc-step-desc { margin-top: 6rpx; font-size: 21rpx; color: #9A96B8; line-height: 1.4; }
.gc-btns { display: flex; gap: 16rpx; margin-top: 32rpx; }
.gc-btn { flex: 1; padding: 22rpx 0; border-radius: 999rpx; text-align: center; font-size: 26rpx; font-weight: 700; }
.gc-skip { background: #F4F2FF; color: #7F77DD; }
.gc-go { background: linear-gradient(135deg,#FFB347,#F5811F); color: #FFF; box-shadow: 0 6rpx 16rpx rgba(245,129,31,.28); }

/* 每日签到长条 */
.sign-bar { display: flex; align-items: center; margin-top: 22rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #FFF0E2; border: 1rpx solid #F5C08A; }
.sign-icon { width: 76rpx; height: 76rpx; border-radius: 18rpx; background: #FFD9A8; display: flex; align-items: center; justify-content: center; font-size: 40rpx; flex-shrink: 0; }
.sign-text { flex: 1; min-width: 0; display: flex; flex-direction: column; margin-left: 20rpx; }
.sign-title { font-size: 28rpx; font-weight: 800; color: #A85A20; }
.sign-sub { margin-top: 6rpx; font-size: 21rpx; color: #C08447; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sign-arrow { font-size: 40rpx; color: #D9893C; }

/* 顶部说明弹层 */
.info-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(20,16,50,0.35); z-index: 100; }
.info-panel { position: fixed; left: 40rpx; right: 40rpx; top: 180rpx; z-index: 101; background: #FFF; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 20rpx 60rpx rgba(20,16,50,0.25); }
.ip-head { display: flex; align-items: center; justify-content: space-between; }
.ip-title { font-size: 30rpx; font-weight: 800; color: #2B2456; }
.ip-close { font-size: 32rpx; color: #A8A4C2; padding: 0 8rpx; }
.ip-big { margin-top: 20rpx; font-size: 52rpx; font-weight: 800; }
.ip-star-num { color: #B5840B; }
.ip-fire-num { color: #D95B36; font-size: 44rpx; }
.ip-energy-num { color: #5B4BD6; }
.ip-sub { display: block; margin-top: 8rpx; font-size: 23rpx; color: #8A86A8; }
.ip-week-label { display: block; margin-top: 28rpx; font-size: 22rpx; color: #6B6692; }
.ip-week { display: flex; gap: 10rpx; margin-top: 14rpx; }
.ip-day { flex: 1; height: 80rpx; border-radius: 14rpx; background: #F4F2FF; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.ip-day.ip-day-on { background: #EAF3DE; }
.ip-day-label { font-size: 20rpx; color: #8A86A8; }
.ip-day-on .ip-day-label { color: #3B6D11; }
.ip-day-dot { font-size: 24rpx; color: #C4BEDC; }
.ip-day-on .ip-day-dot { color: #639922; }
.ip-note { margin-top: 24rpx; border-radius: 16rpx; padding: 22rpx; font-size: 22rpx; line-height: 1.7; display: flex; flex-direction: column; }
.ip-note-star { background: #FFF3D8; color: #B5840B; }
.ip-note-fire { background: #FFF0E8; color: #D95B36; }
.ip-note-energy { background: #EEEDFE; color: #3C3489; }
.ip-freeze-btn { margin-top: 20rpx; padding: 20rpx; border-radius: 999rpx; background: #D95B36; color: #FFF; text-align: center; font-size: 25rpx; font-weight: 700; }
.ip-ad-btn { margin-top: 16rpx; padding: 20rpx; border-radius: 999rpx; background: #FFF0E2; border: 1rpx solid #F5C08A; color: #A85A20; text-align: center; font-size: 25rpx; font-weight: 700; }
.bh-link { color: #7A6FD0; text-decoration: underline; }
.src-body { margin-top: 24rpx; }
.src-row { display: flex; margin-bottom: 18rpx; align-items: flex-start; }
.src-k { flex: 0 0 120rpx; font-size: 22rpx; font-weight: 700; color: #5B4BD6; }
.src-v { flex: 1; font-size: 21rpx; line-height: 1.6; color: #5A5678; }
.src-foot { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #EEEAFB; font-size: 20rpx; color: #9B96B8; text-align: center; }
